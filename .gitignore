# Vidéos sources (souvent > 25 Mo) déposées directement dans assets/video/ :
# elles ne partent pas sur GitHub. Le site utilise les versions compressées
# de assets/video/projects/ — seules les vidéos d'accueil restent à la racine.
/assets/video/*.mp4
/assets/video/*.mov
/assets/video/*.m4v
!/assets/video/hero.mp4
!/assets/video/hero-mobile.mp4

.DS_Store

